# =============================================================================
# Fitness monorepo — environment variable reference
# =============================================================================
# Copy values into the paths below (never commit real secrets):
#   server/.env   — backend (FastAPI)
#   mobile/.env   — Expo app (EXPO_PUBLIC_* are bundled into the client)
#
# Food photo AI and coach features use server-side keys only; do not put
# GROQ/Gemini keys in mobile/.env for production builds.
# =============================================================================

# -----------------------------------------------------------------------------
# server/.env — FastAPI backend
# -----------------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose port if using local DB)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/fitnessdb

# JWT signing secret — Generate with: openssl rand -hex 32
JWT_SECRET=

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# production | development
APP_ENV=development

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081

# Firebase — same Web API key as mobile EXPO_PUBLIC_FIREBASE_API_KEY; verifies ID tokens
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_TOKEN_CLOCK_SKEW_SECONDS=60

# AI providers (server only)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Feedback email (SMTP)
FEEDBACK_TO_EMAIL=admin@example.com
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=587
FEEDBACK_SMTP_USERNAME=
FEEDBACK_SMTP_PASSWORD=
FEEDBACK_FROM_EMAIL=
FEEDBACK_SMTP_USE_TLS=true

# Razorpay payments (optional until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI usage cost conversion
USD_TO_INR_RATE=83.5

# First admin seed (used by server/create_admin.py)
ADMIN_EMAIL=admin@yourapp.com
ADMIN_PASSWORD=changeme

# Optional data file overrides
FOOD_DB_SQL_PATH=
WORKOUT_CATALOG_JSON=

# -----------------------------------------------------------------------------
# mobile/.env — Expo React Native (EXPO_PUBLIC_* exposed to the app bundle)
# -----------------------------------------------------------------------------

# FastAPI base URL (no trailing slash). Use LAN IP or https://api.yourapp.com on devices
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Firebase (Console → Project settings → Your apps → Web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: custom domain for password-reset action links
EXPO_PUBLIC_FIREBASE_ACTION_CONTINUE_URL=

# AI keys are server-only — do not set GROQ/Gemini keys in mobile/.env
