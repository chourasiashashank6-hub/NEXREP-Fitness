# FastAPI base URL (no trailing slash). Default works for Expo web on localhost/127.0.0.1 only.
# For Expo tunnel, HTTPS, or opening the web app from another device, set this to a URL the browser can reach (e.g. http://192.168.x.x:8000) and restart Expo.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Firebase (see Firebase Console → Project settings → Your apps → Web app config)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: override password-reset link domain (default is https://YOUR_AUTH_DOMAIN__/auth/action)
# EXPO_PUBLIC_FIREBASE_ACTION_CONTINUE_URL=https://YOUR_PROJECT.firebaseapp.com/__/auth/action
GROQ_API_KEY=your_key_here
EXPO_PUBLIC_GROQ_API_KEY=your_key_here
