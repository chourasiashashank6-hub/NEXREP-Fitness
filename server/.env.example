# Render sets DATABASE_URL automatically (postgres://… is rewritten to postgresql+psycopg:// at runtime).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/fitnessdb
PORT=8000
# Same value as mobile EXPO_PUBLIC_FIREBASE_API_KEY (Firebase Console → Web app config).
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=repwise-8338b
# Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
# Comma-separated origins for CORS (no spaces required)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_PLACES_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
FEEDBACK_TO_EMAIL=admin@nexrep.in
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=587
FEEDBACK_SMTP_USERNAME=
FEEDBACK_SMTP_PASSWORD=
FEEDBACK_SMTP_USE_TLS=true
FEEDBACK_FROM_EMAIL=

# Admin
ADMIN_EMAIL=admin@yourapp.com
ADMIN_PASSWORD=changeme

# Razorpay (leave blank until bank account is ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Webhooks → secret
RAZORPAY_WEBHOOK_SECRET=

# AI Cost tracking
USD_TO_INR_RATE=83.5

# Dev tier toggle on Profile (APP_ENV=development only). Generate with: openssl rand -hex 32
DEV_TIER_TOGGLE_EMAILS=shashank1@gmail.com
DEV_TOGGLE_SECRET=

# Coach tiered redesign (cadence views, summary API). Set true to enable on production.
COACH_REDESIGN_ENABLED=false
