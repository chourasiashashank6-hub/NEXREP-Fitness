  "quote_samples": {
    "hi": [
      {
        "index": 130,
        "english": "Believe you can and you are halfway there.",
        "translated": "विश्वास करें कि आप कर सकते हैं और आप आधे रास्ते पर हैं।",
        "author": "Theodore Roosevelt"
      },
      {
        "index": 884,
        "english": "A goal without a plan is just a wish.",
        "translated": "बिना योजना के लक्ष्य महज़ एक इच्छा है।",
        "author": "Antoine de Saint-Exupery"
      },
      {
        "index": 678,
        "english": "Choose discipline over motivation.",
        "translated": "प्रेरणा के स्थान पर अनुशासन चुनें.",
        "author": "Jocko Willink"
      },
      {
        "index": 1006,
        "english": "The grind includes the glory.",
        "translated": "पीस में महिमा शामिल है.",
        "author": "Unknown"
      },
      {
        "index": 206,
        "english": "Rest when you are dead.",
        "translated": "जब तुम मर जाओ तो आराम करो.",
        "author": "Unknown"
      },
      {
        "index": 544,
        "english": "You are not overtraining. You are under-eating.",
        "translated": "आप अतिप्रशिक्षण नहीं कर रहे हैं. आप कम खा रहे हैं.",
        "author": "Unknown"
      },
      {
        "index": 786,
        "english": "Never fear the weight. Fear never trying.",
        "translated": "वजन से कभी न डरें. कभी प्रयास न करने से डर लगता है.",
        "author": "Unknown"
      },
      {
        "index": 755,
        "english": "The harder you work, the luckier you get.",
        "translated": "आप जितनी अधिक मेहनत करेंगे, आप उतने ही अधिक भाग्यशाली होंगे।",
        "author": "Gary Player"
      },
      {
        "index": 267,
        "english": "Do something today that your future self will thank you for.",
        "translated": "आज कुछ ऐसा करें जिसके लिए आपका भविष्य आपको धन्यवाद देगा।",
        "author": "Sean Patrick Flanery"
      },
      {
        "index": 442,
        "english": "You can not expect to look like a million bucks if you eat from the dollar menu.",
        "translated": "यदि आप डॉलर मेनू से खाते हैं तो आप दस लाख रुपये की तरह दिखने की उम्मीद नहीं कर सकते।",
        "author": "Unknown"
      },
      {
        "index": 762,
        "english": "You can rest. You can pause. But do not quit.",
        "translated": "आप आराम कर सकते हैं. आप रुक सकते हैं. लेकिन मत छोड़ो.",
        "author": "Unknown"
      },
      {
        "index": 432,
        "english": "Define your goals. Outline a plan. Then go all in.",
        "translated": "अपने लक्ष्य परिभाषित करें. एक योजना की रूपरेखा तैयार करें. फिर सब अंदर जाओ.",
        "author": "Unknown"
      },
      {
        "index": 535,
        "english": "Your arms will not grow by thinking about curls.",
        "translated": "कर्ल्स के बारे में सोचने से आपकी भुजाएं नहीं बढ़ेंगी।",
        "author": "Unknown"
      },
      {
        "index": 957,
        "english": "Eat to live. Do not live to eat.",
        "translated": "जीने के लिए खाओ. खाने के लिए नहीं जीते.",
        "author": "Benjamin Franklin"
      },
      {
        "index": 823,
        "english": "The strongest version of yourself is waiting. Go find it.",
        "translated": "आपका सबसे मजबूत संस्करण प्रतीक्षा कर रहा है। जाओ इसे ढूंढो.",
        "author": "Unknown"
      }
    ],
